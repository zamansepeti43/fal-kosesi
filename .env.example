# AI provider
AI_PROVIDER=huggingface
HF_TOKEN=your_hf_token_here
AI_API_KEY=

# App
NEXTAUTH_SECRET=your-auth-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
MEMBER_SESSION_SECRET=replace-with-a-long-random-secret

# Public merchant/contact information used on legal pages
NEXT_PUBLIC_BUSINESS_NAME=Your legal business name
NEXT_PUBLIC_CONTACT_EMAIL=your-public-contact-email@example.com
NEXT_PUBLIC_CONTACT_PHONE=+90...
NEXT_PUBLIC_BUSINESS_ADDRESS=Your registered business address
NEXT_PUBLIC_TAX_ID=Your tax or identity number
NEXT_PUBLIC_MERSIS=Your MERSIS number if applicable

# iyzico
IYZICO_API_KEY=your_iyzico_api_key
IYZICO_SECRET_KEY=your_iyzico_secret_key
IYZICO_API_URL=https://sandbox-api.iyzipay.com

# Neon PostgreSQL
# Paste the pooled connection string from Neon here.
DATABASE_URL=postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require
